<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="def_bpmn_mejorado_gestion" targetNamespace="http://tesis.sanbartolo/bpmn" exporter="generar_bpmn.py" exporterVersion="1.0">
  <collaboration id="colab_bpmn_mejorado_gestion">
    <participant id="pool_bpmn_mejorado_gestion" name="Gestión tributaria predial con el sistema web (situación mejorada)" processRef="proc_bpmn_mejorado_gestion"/>
  </collaboration>
  <process id="proc_bpmn_mejorado_gestion" name="Gestión tributaria predial con el sistema web (situación mejorada)" isExecutable="false">
    <laneSet id="lanes">
      <lane id="lane_0" name="Contribuyente">
        <flowNodeRef>ini</flowNodeRef>
        <flowNodeRef>g1</flowNodeRef>
        <flowNodeRef>t3</flowNodeRef>
      </lane>
      <lane id="lane_1" name="Caja">
        <flowNodeRef>t4</flowNodeRef>
        <flowNodeRef>t5</flowNodeRef>
        <flowNodeRef>f1</flowNodeRef>
      </lane>
      <lane id="lane_2" name="Rentas">
        <flowNodeRef>t1</flowNodeRef>
        <flowNodeRef>t7</flowNodeRef>
        <flowNodeRef>t8</flowNodeRef>
        <flowNodeRef>g2</flowNodeRef>
        <flowNodeRef>t9</flowNodeRef>
        <flowNodeRef>f2</flowNodeRef>
      </lane>
      <lane id="lane_3" name="Ejecutoría coactiva">
        <flowNodeRef>t10</flowNodeRef>
        <flowNodeRef>f3</flowNodeRef>
      </lane>
      <lane id="lane_4" name="Sistema web y modelo de ML">
        <flowNodeRef>t2</flowNodeRef>
        <flowNodeRef>t6</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="ini" name="Presenta declaración jurada">
      <outgoing>flujo_1</outgoing>
    </startEvent>
    <task id="t1" name="Registrar el predio en el sistema web">
      <incoming>flujo_1</incoming>
      <outgoing>flujo_2</outgoing>
    </task>
    <serviceTask id="t2" name="Calcular y emitir las deudas automáticamente">
      <incoming>flujo_2</incoming>
      <outgoing>flujo_3</outgoing>
    </serviceTask>
    <exclusiveGateway id="g1" name="¿Paga antes del vencimiento?">
      <incoming>flujo_3</incoming>
      <outgoing>flujo_4</outgoing>
      <outgoing>flujo_8</outgoing>
    </exclusiveGateway>
    <task id="t3" name="Pagar en caja">
      <incoming>flujo_4</incoming>
      <outgoing>flujo_5</outgoing>
    </task>
    <task id="t4" name="Cobrar y emitir recibo correlativo">
      <incoming>flujo_5</incoming>
      <outgoing>flujo_6</outgoing>
    </task>
    <task id="t5" name="Cerrar la caja del día por cajero">
      <incoming>flujo_6</incoming>
      <outgoing>flujo_7</outgoing>
    </task>
    <endEvent id="f1" name="Deuda cancelada">
      <incoming>flujo_7</incoming>
    </endEvent>
    <serviceTask id="t6" name="Modelo ML: grupo, deuda esperada y acción sugerida">
      <incoming>flujo_8</incoming>
      <outgoing>flujo_9</outgoing>
    </serviceTask>
    <task id="t7" name="Priorizar la cobranza con la lista (tramos A, B y C)">
      <incoming>flujo_9</incoming>
      <outgoing>flujo_10</outgoing>
    </task>
    <task id="t8" name="Enviar recordatorios y valores a los priorizados">
      <incoming>flujo_10</incoming>
      <outgoing>flujo_11</outgoing>
    </task>
    <exclusiveGateway id="g2" name="¿Firma convenio?">
      <incoming>flujo_11</incoming>
      <outgoing>flujo_12</outgoing>
      <outgoing>flujo_14</outgoing>
    </exclusiveGateway>
    <task id="t9" name="Registrar el fraccionamiento">
      <incoming>flujo_12</incoming>
      <outgoing>flujo_13</outgoing>
    </task>
    <endEvent id="f2" name="Deuda fraccionada">
      <incoming>flujo_13</incoming>
    </endEvent>
    <task id="t10" name="Recibir el valor transferido y asignarlo a un auxiliar">
      <incoming>flujo_14</incoming>
      <outgoing>flujo_15</outgoing>
    </task>
    <endEvent id="f3" name="Cobranza coactiva">
      <incoming>flujo_15</incoming>
    </endEvent>
    <sequenceFlow id="flujo_1" sourceRef="ini" targetRef="t1"/>
    <sequenceFlow id="flujo_2" sourceRef="t1" targetRef="t2"/>
    <sequenceFlow id="flujo_3" sourceRef="t2" targetRef="g1"/>
    <sequenceFlow id="flujo_4" name="Sí" sourceRef="g1" targetRef="t3"/>
    <sequenceFlow id="flujo_5" sourceRef="t3" targetRef="t4"/>
    <sequenceFlow id="flujo_6" sourceRef="t4" targetRef="t5"/>
    <sequenceFlow id="flujo_7" sourceRef="t5" targetRef="f1"/>
    <sequenceFlow id="flujo_8" name="No" sourceRef="g1" targetRef="t6"/>
    <sequenceFlow id="flujo_9" sourceRef="t6" targetRef="t7"/>
    <sequenceFlow id="flujo_10" sourceRef="t7" targetRef="t8"/>
    <sequenceFlow id="flujo_11" sourceRef="t8" targetRef="g2"/>
    <sequenceFlow id="flujo_12" name="Sí" sourceRef="g2" targetRef="t9"/>
    <sequenceFlow id="flujo_13" sourceRef="t9" targetRef="f2"/>
    <sequenceFlow id="flujo_14" name="No" sourceRef="g2" targetRef="t10"/>
    <sequenceFlow id="flujo_15" sourceRef="t10" targetRef="f3"/>
  </process>
  <bpmndi:BPMNDiagram id="dia_bpmn_mejorado_gestion">
    <bpmndi:BPMNPlane id="plano_bpmn_mejorado_gestion" bpmnElement="colab_bpmn_mejorado_gestion">
      <bpmndi:BPMNShape id="pool_bpmn_mejorado_gestion_di" bpmnElement="pool_bpmn_mejorado_gestion" isHorizontal="true"><dc:Bounds x="0" y="0" width="1574" height="600"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_0_di" bpmnElement="lane_0" isHorizontal="true"><dc:Bounds x="40" y="0" width="1534" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_1_di" bpmnElement="lane_1" isHorizontal="true"><dc:Bounds x="40" y="120" width="1534" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_2_di" bpmnElement="lane_2" isHorizontal="true"><dc:Bounds x="40" y="240" width="1534" height="120"/></bpmndi:BPMNShape>
