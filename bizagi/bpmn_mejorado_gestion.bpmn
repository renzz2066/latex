      <bpmndi:BPMNShape id="lane_4_di" bpmnElement="lane_4" isHorizontal="true"><dc:Bounds x="40" y="480" width="1534" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ini_di" bpmnElement="ini"><dc:Bounds x="131" y="42" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="238" y="260" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="388" y="500" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="574" y="35" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="688" y="20" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="838" y="140" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="988" y="140" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="f1_di" bpmnElement="f1"><dc:Bounds x="1181" y="162" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="688" y="500" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t7_di" bpmnElement="t7"><dc:Bounds x="838" y="260" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t8_di" bpmnElement="t8"><dc:Bounds x="988" y="260" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="1174" y="275" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t9_di" bpmnElement="t9"><dc:Bounds x="1288" y="260" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="f2_di" bpmnElement="f2"><dc:Bounds x="1481" y="282" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t10_di" bpmnElement="t10"><dc:Bounds x="1288" y="380" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="f3_di" bpmnElement="f3"><dc:Bounds x="1481" y="402" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flujo_1_di" bpmnElement="flujo_1">
        <di:waypoint x="167" y="60"/>
        <di:waypoint x="224" y="60"/>
        <di:waypoint x="224" y="300"/>
        <di:waypoint x="238" y="300"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_2_di" bpmnElement="flujo_2">
        <di:waypoint x="360" y="300"/>
        <di:waypoint x="374" y="300"/>
        <di:waypoint x="374" y="540"/>
        <di:waypoint x="388" y="540"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_3_di" bpmnElement="flujo_3">
        <di:waypoint x="510" y="540"/>
        <di:waypoint x="560" y="540"/>
        <di:waypoint x="560" y="60"/>
        <di:waypoint x="574" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_4_di" bpmnElement="flujo_4">
        <di:waypoint x="624" y="60"/>
        <di:waypoint x="688" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_5_di" bpmnElement="flujo_5">
        <di:waypoint x="810" y="60"/>
        <di:waypoint x="824" y="60"/>
        <di:waypoint x="824" y="180"/>
        <di:waypoint x="838" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_6_di" bpmnElement="flujo_6">
        <di:waypoint x="960" y="180"/>
        <di:waypoint x="988" y="180"/>
