<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="def_bpmn_actual_soporte" targetNamespace="http://tesis.sanbartolo/bpmn" exporter="generar_bpmn.py" exporterVersion="1.0">
  <collaboration id="colab_bpmn_actual_soporte">
    <participant id="pool_bpmn_actual_soporte" name="Atención de soporte técnico de Sispredios (situación actual)" processRef="proc_bpmn_actual_soporte"/>
  </collaboration>
  <process id="proc_bpmn_actual_soporte" name="Atención de soporte técnico de Sispredios (situación actual)" isExecutable="false">
    <laneSet id="lanes">
      <lane id="lane_0" name="Personal municipal">
        <flowNodeRef>ini</flowNodeRef>
        <flowNodeRef>t1</flowNodeRef>
        <flowNodeRef>t8</flowNodeRef>
        <flowNodeRef>f1</flowNodeRef>
      </lane>
      <lane id="lane_1" name="Desarrollador (Consultoría Informática)">
        <flowNodeRef>t2</flowNodeRef>
        <flowNodeRef>g1</flowNodeRef>
        <flowNodeRef>t3</flowNodeRef>
        <flowNodeRef>t4</flowNodeRef>
        <flowNodeRef>t5</flowNodeRef>
        <flowNodeRef>t6</flowNodeRef>
        <flowNodeRef>t7</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="ini" name="Ocurre una incidencia">
      <outgoing>flujo_1</outgoing>
    </startEvent>
    <task id="t1" name="Reportar la incidencia o el pedido de cambio">
      <incoming>flujo_1</incoming>
      <outgoing>flujo_2</outgoing>
    </task>
    <task id="t2" name="Analizar la incidencia (único desarrollador)">
      <incoming>flujo_2</incoming>
      <outgoing>flujo_3</outgoing>
    </task>
    <exclusiveGateway id="g1" name="¿Dónde está el error?">
      <incoming>flujo_3</incoming>
      <outgoing>flujo_4</outgoing>
      <outgoing>flujo_9</outgoing>
    </exclusiveGateway>
    <task id="t3" name="Modificar el código en Visual FoxPro">
      <incoming>flujo_4</incoming>
      <outgoing>flujo_5</outgoing>
    </task>
    <task id="t4" name="Recompilar el ejecutable completo (27–28 MB)">
      <incoming>flujo_5</incoming>
      <outgoing>flujo_6</outgoing>
    </task>
    <task id="t5" name="Copiar el ejecutable en cada equipo">
      <incoming>flujo_6</incoming>
      <outgoing>flujo_7</outgoing>
    </task>
    <task id="t6" name="Adaptar la corrección en la copia de cada municipalidad">
      <incoming>flujo_7</incoming>
      <outgoing>flujo_8</outgoing>
    </task>
    <task id="t7" name="Corregir los datos con un programa escrito para el caso">
      <incoming>flujo_9</incoming>
      <outgoing>flujo_10</outgoing>
    </task>
    <task id="t8" name="Reanudar el trabajo detenido">
      <incoming>flujo_8</incoming>
      <incoming>flujo_10</incoming>
      <outgoing>flujo_11</outgoing>
    </task>
    <endEvent id="f1" name="Incidencia atendida">
      <incoming>flujo_11</incoming>
    </endEvent>
    <sequenceFlow id="flujo_1" sourceRef="ini" targetRef="t1"/>
    <sequenceFlow id="flujo_2" sourceRef="t1" targetRef="t2"/>
    <sequenceFlow id="flujo_3" sourceRef="t2" targetRef="g1"/>
    <sequenceFlow id="flujo_4" name="Código" sourceRef="g1" targetRef="t3"/>
    <sequenceFlow id="flujo_5" sourceRef="t3" targetRef="t4"/>
    <sequenceFlow id="flujo_6" sourceRef="t4" targetRef="t5"/>
    <sequenceFlow id="flujo_7" sourceRef="t5" targetRef="t6"/>
    <sequenceFlow id="flujo_8" sourceRef="t6" targetRef="t8"/>
    <sequenceFlow id="flujo_9" name="Datos" sourceRef="g1" targetRef="t7"/>
    <sequenceFlow id="flujo_10" sourceRef="t7" targetRef="t8"/>
    <sequenceFlow id="flujo_11" sourceRef="t8" targetRef="f1"/>
  </process>
  <bpmndi:BPMNDiagram id="dia_bpmn_actual_soporte">
    <bpmndi:BPMNPlane id="plano_bpmn_actual_soporte" bpmnElement="colab_bpmn_actual_soporte">
      <bpmndi:BPMNShape id="pool_bpmn_actual_soporte_di" bpmnElement="pool_bpmn_actual_soporte" isHorizontal="true"><dc:Bounds x="0" y="0" width="1574" height="360"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_0_di" bpmnElement="lane_0" isHorizontal="true"><dc:Bounds x="40" y="0" width="1534" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_1_di" bpmnElement="lane_1" isHorizontal="true"><dc:Bounds x="40" y="120" width="1534" height="240"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ini_di" bpmnElement="ini"><dc:Bounds x="131" y="42" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="238" y="20" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="388" y="140" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="574" y="155" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="688" y="140" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="838" y="140" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="988" y="140" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="1138" y="140" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t7_di" bpmnElement="t7"><dc:Bounds x="688" y="260" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t8_di" bpmnElement="t8"><dc:Bounds x="1288" y="20" width="122" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="f1_di" bpmnElement="f1"><dc:Bounds x="1481" y="42" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flujo_1_di" bpmnElement="flujo_1">
        <di:waypoint x="167" y="60"/>
        <di:waypoint x="238" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_2_di" bpmnElement="flujo_2">
        <di:waypoint x="360" y="60"/>
        <di:waypoint x="374" y="60"/>
        <di:waypoint x="374" y="180"/>
        <di:waypoint x="388" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_3_di" bpmnElement="flujo_3">
        <di:waypoint x="510" y="180"/>
        <di:waypoint x="574" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_4_di" bpmnElement="flujo_4">
        <di:waypoint x="624" y="180"/>
        <di:waypoint x="688" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_5_di" bpmnElement="flujo_5">
        <di:waypoint x="810" y="180"/>
        <di:waypoint x="838" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_6_di" bpmnElement="flujo_6">
        <di:waypoint x="960" y="180"/>
        <di:waypoint x="988" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_7_di" bpmnElement="flujo_7">
        <di:waypoint x="1110" y="180"/>
        <di:waypoint x="1138" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_8_di" bpmnElement="flujo_8">
        <di:waypoint x="1260" y="180"/>
        <di:waypoint x="1274" y="180"/>
        <di:waypoint x="1274" y="60"/>
        <di:waypoint x="1288" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_9_di" bpmnElement="flujo_9">
        <di:waypoint x="599" y="205"/>
        <di:waypoint x="599" y="300"/>
        <di:waypoint x="688" y="300"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_10_di" bpmnElement="flujo_10">
        <di:waypoint x="810" y="300"/>
        <di:waypoint x="1274" y="300"/>
        <di:waypoint x="1274" y="60"/>
        <di:waypoint x="1288" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flujo_11_di" bpmnElement="flujo_11">
        <di:waypoint x="1410" y="60"/>
        <di:waypoint x="1481" y="60"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
